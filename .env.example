# Telegram
BOT_TOKEN=
WEBHOOK_HOST=https://bot.example.com
WEBHOOK_PORT=8080
REQUIRED_CHANNEL=            # @channel или пусто, если подписка не нужна

# Infra
DATABASE_URL=postgresql://uniq:uniq@db:5432/uniq
REDIS_URL=redis://redis:6379/0
SERVICE_SECRET=              # 32+ случайных байта в hex, сид генератора

# Processing
MAX_FILE_MB=150
WORK_DIR=/srv/work
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Billing
CREDIT_TTL_DAYS=30
REFERRAL_BONUS=30
