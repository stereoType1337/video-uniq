# Telegram
BOT_TOKEN=
# Вебхук принимает локальный telegram-bot-api по внутренней сети, наружу не торчит
WEBHOOK_HOST=http://video_uniq_bot:8080
WEBHOOK_PORT=8080
# Telegram id через запятую: доступ к /admin
ADMIN_IDS=
# @username поддержки для /support
SUPPORT_CONTACT=
# Юр. страницы /terms и /privacy (пока OPERATOR_NAME пуст — плашка «черновик»)
OPERATOR_NAME=
# ИНН / ОГРНИП и т.п.
OPERATOR_DETAILS=
CONTACT_EMAIL=
BOT_USERNAME=UniqReelBot
# @channel или пусто, если подписка не нужна
REQUIRED_CHANNEL=

# Локальный Bot API (файлы до 2 ГБ). api_id/api_hash: my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_URL=http://video_uniq_tg_api:8081

# Infra
DATABASE_URL=postgresql://uniq:uniq@db:5432/uniq
REDIS_URL=redis://redis:6379/0
# 32+ случайных байта в hex, сид генератора
SERVICE_SECRET=

# Processing
MAX_FILE_MB=150
MIN_DURATION_S=0.5
# 3 минуты; разрешение до 4K@30 / 1080p@60, только mp4/mov
MAX_DURATION_S=180
# задач в очереди/в работе на одного пользователя
MAX_ACTIVE_JOBS=2
# исходники и копии удаляются через N часов
FILES_TTL_HOURS=24
FPCALC_BIN=fpcalc
# параллельных FFmpeg на воркер (8 vCPU: 4)
RENDER_SLOTS=4
# потоков на один FFmpeg (8 vCPU: 2)
FFMPEG_THREADS=2
# задач одновременно на воркер, делят RENDER_SLOTS
WORKER_MAX_JOBS=2
WORK_DIR=/srv/work
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Billing
CREDIT_TTL_DAYS=30
# обоим, после первой обработки приглашённого
REFERRAL_BONUS=30
# бесплатно при регистрации
FREE_CREDITS=5

# Кассы в рублях: касса включается, только когда заданы её ключи (иначе кнопки нет)
# Kassa AI (FreeKassa): СБП и карты
KASSAI_SHOP_ID=
KASSAI_API_KEY=
KASSAI_SECRET_KEY2=
KASSAI_CARDS_ENABLED=true
# Platega: СБП / QR
PLATEGA_MERCHANT_ID=
PLATEGA_API_KEY=
PLATEGA_METHOD_CODE=2
