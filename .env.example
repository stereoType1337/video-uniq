# Telegram
BOT_TOKEN=
# Вебхук принимает локальный telegram-bot-api по внутренней сети, наружу не торчит
WEBHOOK_HOST=http://video_uniq_bot:8080
WEBHOOK_PORT=8080
REQUIRED_CHANNEL=            # @channel или пусто, если подписка не нужна

# Локальный Bot API (файлы до 2 ГБ). api_id/api_hash: my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_URL=http://video_uniq_tg_api:8081

# Infra
DATABASE_URL=postgresql://uniq:uniq@db:5432/uniq
REDIS_URL=redis://redis:6379/0
SERVICE_SECRET=              # 32+ случайных байта в hex, сид генератора

# Processing
MAX_FILE_MB=150
MIN_DURATION_S=0.5
MAX_DURATION_S=180          # 3 минуты; разрешение до 4K@30 / 1080p@60, только mp4/mov
MAX_ACTIVE_JOBS=2            # задач в очереди/в работе на одного пользователя
FILES_TTL_HOURS=24           # исходники и копии удаляются через N часов
FPCALC_BIN=fpcalc
WORK_DIR=/srv/work
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Billing
CREDIT_TTL_DAYS=30
REFERRAL_BONUS=30            # обоим, после первой обработки приглашённого
FREE_CREDITS=5               # бесплатно при регистрации
